#!/bin/sh
set -u

pass=0
fail=0

ok() {
    pass=$((pass + 1))
    printf 'PASS  %s\n' "$1"
}

bad() {
    fail=$((fail + 1))
    printf 'FAIL  %s\n' "$1"
}

info() {
    printf 'INFO  %s\n' "$1"
}

have() {
    command -v "$1" >/dev/null 2>&1
}

printf '%s\n' 'North Echo Linux preflight (non-destructive)'

if [ "$(uname -s 2>/dev/null)" = Linux ]; then
    ok 'Linux kernel detected'
else
    bad 'Linux kernel required for lessons and kernel validation'
    exit 1
fi

if [ "$(id -u)" -ne 0 ]; then
    ok 'running as an ordinary non-root user'
else
    bad 'run the course as an ordinary non-root user'
fi

for tool in python3 cc strace unshare nsenter setpriv capsh getcap setcap ps pkg-config ip systemd-run systemctl timeout; do
    if have "$tool"; then
        ok "required course tool available: $tool"
    else
        bad "missing required course tool: $tool"
    fi
done

if [ -r /usr/include/linux/landlock.h ] && [ -r /usr/include/linux/openat2.h ]; then
    ok 'openat2 and Landlock userspace headers are available'
else
    bad 'Module 05 requires Linux openat2 and Landlock userspace headers'
fi

if [ -r /usr/include/seccomp.h ] && pkg-config --exists libseccomp 2>/dev/null; then
    ok "libseccomp development files available: $(pkg-config --modversion libseccomp)"
else
    bad 'Module 06 requires libseccomp development files discoverable by pkg-config'
fi

for path in /proc/self/status /proc/self/ns/user /proc/self/ns/uts /proc/self/ns/pid /proc/self/ns/mnt /proc/self/ns/net; do
    if [ -e "$path" ]; then
        ok "kernel interface available: $path"
    else
        bad "missing kernel interface: $path"
    fi
done

if have unshare && unshare --user --map-root-user true >/dev/null 2>&1; then
    ok 'unprivileged user namespace creation works'
else
    bad 'unprivileged user namespace creation failed'
fi

if have unshare && unshare --user --map-root-user --net true >/dev/null 2>&1; then
    ok 'unprivileged network namespace creation works'
else
    bad 'Module 08 requires unprivileged user plus network namespace creation'
fi

if [ -r /proc/self/status ] && grep -q '^NoNewPrivs:' /proc/self/status; then
    ok 'NoNewPrivs state is exposed in /proc/self/status'
else
    bad 'NoNewPrivs state is not visible'
fi

if [ -r /proc/self/status ] && grep -q '^CapBnd:' /proc/self/status; then
    ok 'capability state is exposed in /proc/self/status'
else
    bad 'capability state is not visible'
fi

printf '\n%s\n' 'Full-course behavioral readiness'

probe_dir=$(mktemp -d)
trap 'rm -rf -- "$probe_dir"' EXIT HUP INT TERM
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
printf 'allowed\n' > "$probe_dir/allowed"
printf 'denied\n' > "$probe_dir/denied"
if cc -std=c11 -Wall -Wextra -Werror -O2 -static "$script_dir/preflight_probe.c" \
    -o "$probe_dir/kernel-probe" -lseccomp && \
    timeout 10 "$probe_dir/kernel-probe" "$probe_dir/allowed" "$probe_dir/denied"; then
    ok 'Modules 05-06: static toolchain, openat2, Landlock and seccomp enforce policy'
else
    bad 'Modules 05-06: behavioral kernel-policy or static-toolchain check failed'
fi

for tool in nft jq; do
    if have "$tool"; then
        info "available future tool: $tool"
    else
        info "future tool not installed yet: $tool"
    fi
done

if [ -r /sys/fs/cgroup/cgroup.controllers ] && grep -qw cpu /sys/fs/cgroup/cgroup.controllers && grep -qw memory /sys/fs/cgroup/cgroup.controllers && grep -qw pids /sys/fs/cgroup/cgroup.controllers; then
    ok 'Modules 07/10: cgroup v2 controllers are visible'
else
    bad 'Modules 07/10 require cgroup v2 cpu, memory, and pids controllers'
fi

if systemctl --user show-environment >/dev/null 2>&1; then
    ok 'Modules 07/10: systemd user manager is reachable'
else
    bad 'Modules 07/10: systemd user manager is not reachable in this session'
fi

if timeout 20 systemd-run --user --wait --pipe --collect --quiet \
    --property=RuntimeMaxSec=10s --property=TimeoutStopSec=3s \
    --property=CPUQuota=50% --property=MemoryMax=64M \
    --property=MemorySwapMax=0 --property=TasksMax=16 -- sh -eu -c '
      relative=$(sed -n "s/^0:://p" /proc/self/cgroup)
      base=/sys/fs/cgroup$relative
      test "$(cat "$base/cpu.max")" = "50000 100000"
      test "$(cat "$base/memory.max")" = 67108864
      test "$(cat "$base/memory.swap.max")" = 0
      test "$(cat "$base/pids.max")" = 16
    '; then
    ok 'Modules 07/10: delegated CPU, memory, swap and task limits are effective'
else
    bad 'Modules 07/10: delegated resource controls did not become effective'
fi

printf '\nSUMMARY: %s required checks passed; %s required checks failed\n' "$pass" "$fail"

if [ "$fail" -ne 0 ]; then
    exit 1
fi
